{% extends "generic/run_qunex.sh" %}
{% block pipeline_specific %}

echo "AUX_DIR is $AUX_DIR"
AUX_DIR=/ceph/intradb/chpc_resources

# MM note: need to link these things per Qunex expectations that
# are not sufficiently handled by `hcp-pipelines/lib/get_data.py
ln -s $StudyFolder/rfMRI_REST1_AP $StudyFolder/sessions/$Session/hcp/$Session/
ln -s $StudyFolder/rfMRI_REST1_PA $StudyFolder/sessions/$Session/hcp/$Session/


${QUNEXCOMMAND} hcp_transmit_bias_individual \
	--sessionsfolder="$StudyFolder/sessions" \
	--batchfile="$StudyFolder/processing/batch.txt" \
	--sessions="$Session" \
	--hcp_transmit_mode="PseudoTransmit" \
	--hcp_pt_fmri_names="rfMRI_REST1_AP,rfMRI_REST1_PA" \
	--hcp_myelin_template="$AUX_DIR/TransmitBias/Partial.MyelinMap_GroupCorr_MSMAll.32k_fs_LR.dscalar.nii" \
	--hcp_group_uncorrected_myelin="$AUX_DIR/TransmitBias/HCA722_Winter2021.MyelinMap_GroupCorr_MSMAll.32k_fs_LR.dscalar.nii" \
	--hcp_pt_reference_value_file="$AUX_DIR/TransmitBias/pt_reference_value.txt" \
	--hcp_gmwm_template="$AUX_DIR/TransmitBias/HCA722_Winter2021_GMWMTemplate.nii.gz" \
	--hcp_unproc_t1w_list="$StudyFolder/unprocessed/T1w_MPR_vNav_4e_e1e2_mean/${Session}_T1w_MPR_vNav_4e_e1e2_mean.nii.gz" \
	--hcp_unproc_t2w_list="$StudyFolder/unprocessed/T2w_SPC_vNav/${Session}_T2w_SPC_vNav.nii.gz" \
	--hcp_raw_psn_t1w="$StudyFolder/unprocessed/T1w_MPR_vNav_4e_RMS/OTHER_FILES/${Session}_T1w_MPR_vNav_Norm_4e_RMS.nii.gz" \
	--hcp_raw_nopsn_t1w="$StudyFolder/unprocessed/T1w_MPR_vNav_4e_e1e2_mean/OTHER_FILES/${Session}_T1w_MPR_vNav_4e_RMS.nii.gz" \
	--hcp_regname="MSMAll" \
	--hcp_low_res_mesh=32 \
	--hcp_grayordinates_res=2

{% endblock pipeline_specific %}

